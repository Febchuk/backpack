PORT=8787
MOCK_GEMINI=1
MOCK_DIAL=1
GEMINI_API_KEY=
DIAL_API_KEY=
PUBLIC_URL=
DB_PATH=./backpack.db
DIAL_FROM_NUMBER_ID=
DIAL_WEBHOOK_SECRET=
DIAL_CALL_LANGUAGE=fr-FR
VOICE_MODE=managed
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
DIAL_SELF_HOSTED_SECRET=
GEMINI_NPC_MODEL=
GEMINI_IMAGE_MODEL=
TEST_PHONE=

# ─── Coach (apps/coach) ───
COACH_PORT=8788
MOCK_ELEVENLABS=1
# Postgres with pgvector (Railway). Unset → in-process PGlite; PGLITE_DIR keeps it on disk.
DATABASE_URL=
PGLITE_DIR=
# Bearer token for /api/* (the console sends VITE_ADMIN_TOKEN). Required in production.
ADMIN_TOKEN=
COACH_GEMINI_MODEL=
